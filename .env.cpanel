# ==============================================================================
# Konfigurasi Siap Pakai untuk cPanel: https://galaxyfleet.web.id/bikeinspect
# ==============================================================================
# Cara pakai di cPanel:
#   Salin file ini menjadi ".env" di folder aplikasi (/home/<cpanel_user>/bikeinspect/.env)
#   lalu ganti <cpanel_user> dan kedua nilai SECRET di bawah.
# ==============================================================================

NODE_ENV=production
# Biarkan PORT dikelola otomatis oleh cPanel LiteSpeed / Passenger:
# PORT=3001

# Mode Cepat Tanpa Login (cukup isi Nama Pemeriksa di bagian atas aplikasi)
# Ubah ke false jika suatu saat ingin mengaktifkan kembali layar login + peran
DISABLE_AUTH=true

# Subpath /bikeinspect pada domain galaxyfleet.web.id
# (Jika memakai subdomain bikeinspect.galaxyfleet.web.id, ubah APP_BASE_PATH= kosong)
APP_BASE_PATH=/bikeinspect
APP_BASE_URL=https://galaxyfleet.web.id/bikeinspect

# Ganti kedua rahasia berikut dengan teks acak minimal 32 karakter
SESSION_SECRET=ganti-dengan-rahasia-sesi-acak-minimal-32-karakter-unik
SIGNED_URL_SECRET=ganti-dengan-rahasia-foto-acak-minimal-32-karakter-unik
SESSION_TIMEOUT_MINUTES=30
SIGNED_URL_TTL_SECONDS=300

# Lokasi database SQLite & foto bukti privat (di luar public_html agar aman)
# Ganti <cpanel_user> dengan username cPanel Anda (atau biarkan ./data/... karena folder repo sudah di luar public_html)
DB_PATH=./data/inspeksi.db
UPLOAD_DIR=./data/uploads

# OCR Plat Nomor (server-side only)
# Nilai: demo | http
OCR_PROVIDER=demo
OCR_API_URL=
OCR_API_KEY=
OCR_TIMEOUT_MS=8000
OCR_CONFIDENCE_THRESHOLD=0.85
