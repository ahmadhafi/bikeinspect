# Server
PORT=3001
NODE_ENV=production
# Subpath untuk cPanel (kosongkan bila di root domain)
APP_BASE_PATH=/bikeinspect
APP_BASE_URL=https://galaxyfleet.web.id/bikeinspect
SESSION_SECRET=ganti-dengan-rahasia-acak-panjang-minimal-32-karakter
SIGNED_URL_SECRET=ganti-dengan-rahasia-tautan-foto-minimal-32-karakter
SESSION_TIMEOUT_MINUTES=30
SIGNED_URL_TTL_SECONDS=300

# Database & Penyimpanan Privat (di cPanel arahkan ke luar public_html!)
DB_PATH=./data/inspeksi.db
UPLOAD_DIR=./data/uploads

# Integrasi OCR (server-side only; jangan pernah ditaruh di frontend)
# Nilai: demo | http
OCR_PROVIDER=demo
# Isi bila OCR_PROVIDER=http (adaptor layanan OCR plat nyata)
OCR_API_URL=
OCR_API_KEY=
OCR_TIMEOUT_MS=8000
OCR_CONFIDENCE_THRESHOLD=0.85
